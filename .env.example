# =============================================
# Configuración SMTP para Recuperación de Contraseña
# =============================================
# Renombra este archivo a .env y ajusta los valores
# IMPORTANTE: Nunca subas este archivo a control de versiones (git)
# =============================================

# --- Gmail (recomendado para desarrollo) ---
# Habilita "Contraseñas de aplicación" en tu cuenta de Google
# https://myaccount.google.com/security > Verificación en dos pasos > Contraseñas de aplicación
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion
MAIL_FROM_ADDRESS=tu_correo@gmail.com
MAIL_FROM_NAME=Gero Actividades

# --- Outlook / Hotmail ---
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=tu_correo@outlook.com
# MAIL_PASSWORD=tu_contraseña

# --- Servidor SMTP propio ---
# MAIL_HOST=mail.tudominio.com
# MAIL_PORT=465
# MAIL_ENCRYPTION=ssl
# MAIL_USERNAME=noreply@tudominio.com
# MAIL_PASSWORD=tu_contraseña
